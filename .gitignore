documentation/
letta/
langgraph/

# Markdown files (except README.md)
*.md
!README.md

# Images - exclude all by default, then allow specific ones
*.png
*.jpg
*.jpeg
# Allow useful images in images folder
!images/llm_email_agent_memory_architecture.png
!images/multi_tier_memory_email_agent_methodology.png
!images/memory.png
!images/methodology.jpeg
!images/lost-in-the-middle.jpg
# Explicitly exclude AI_RT.png
AI_RT.png
images/AI_RT.png

# Reproducibility artifacts released with the paper.
# The raw Enron maildir is 423 MB and is a public download, so only the
# derived 200-email subset and its labels are versioned here.
experiments/data/enron/
# Cold-tier gzip archives are regenerated by any run.
experiments/data/archive/
# Superseded first-campaign outputs.
experiments/data/_v1/
experiments/results/_v1/
experiments/results/_v1_nociting/
# The released corpora and per-email logs override the blanket rules above.
!experiments/data/*.jsonl
!experiments/data/*.csv
!experiments/data/stats.json
!experiments/results/**/*.jsonl
!experiments/results/**/*.json
!experiments/**/*.md

# OS files
.DS_Store
Thumbs.db

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

